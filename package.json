{
  "name": "pos-v1-pedro",
  "version": "1.0.16",
  "description": "POS La Estampida",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-force-exit test/pos.test.js",
    "desktop": "electron .",
    "dist": "electron-builder",
    "release": "node scripts/release.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.laestampida.pos",
    "productName": "POS La Estampida",
    "files": [
      "electron/**",
      "server.js",
      "splash.html",
      "public/**",
      "src/**",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pedronolasco564-blip",
        "repo": "pos-estampida-actualizaciones",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
